{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "loom-storybook": {
      "projectType": "library",
      "root": "",
      "sourceRoot": ".",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:browser",
          "options": {
            "outputPath": "dist/loom-storybook-bootstrap",
            "index": ".storybook-angular/bootstrap/index.html",
            "main": ".storybook-angular/bootstrap/main.ts",
            "tsConfig": ".storybook-angular/tsconfig.json",
            "polyfills": [],
            "assets": [],
            "styles": [],
            "scripts": []
          }
        },
        "storybook": {
          "builder": "@storybook/angular:start-storybook",
          "options": {
            "configDir": ".storybook-angular",
            "browserTarget": "loom-storybook:build",
            "port": 6007,
            "experimentalZoneless": true,
            "compodoc": false
          }
        },
        "build-storybook": {
          "builder": "@storybook/angular:build-storybook",
          "options": {
            "configDir": ".storybook-angular",
            "tsConfig": ".storybook-angular/tsconfig.json",
            "outputDir": "storybook-static",
            "experimentalZoneless": true,
            "compodoc": false
          }
        }
      }
    }
  }
}
