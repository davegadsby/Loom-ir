{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loom-ir.dev/schema/section.schema.json",
  "title": "Loom spec node block",
  "description": "Shape of the fenced ```yaml block under a spec's ### sub-heading. The heading text is the node's slug; prose below the fence becomes the node's description/claim text. `kind` selects which of the §5.3 taxonomy node shapes applies.",
  "oneOf": [
    { "$ref": "#/$defs/prop" },
    { "$ref": "#/$defs/event" },
    { "$ref": "#/$defs/slot" },
    { "$ref": "#/$defs/method" },
    { "$ref": "#/$defs/field" },
    { "$ref": "#/$defs/derived" },
    { "$ref": "#/$defs/state" },
    { "$ref": "#/$defs/transition" },
    { "$ref": "#/$defs/guard" },
    { "$ref": "#/$defs/rule" },
    { "$ref": "#/$defs/invariant" },
    { "$ref": "#/$defs/property" },
    { "$ref": "#/$defs/path" },
    { "$ref": "#/$defs/unexpressible" },
    { "$ref": "#/$defs/patternConformance" },
    { "$ref": "#/$defs/delta" },
    { "$ref": "#/$defs/ariaRelation" },
    { "$ref": "#/$defs/tokenRef" },
    { "$ref": "#/$defs/layoutIntent" },
    { "$ref": "#/$defs/visualConformance" },
    { "$ref": "#/$defs/uses" }
  ],
  "$defs": {
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "type": "string", "enum": ["key", "event", "pointer"] },
        "key": { "type": "string" },
        "context": { "type": "string" },
        "name": { "type": "string" }
      }
    },
    "prop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "type"],
      "properties": {
        "kind": { "const": "prop" },
        "type": { "type": "string", "description": "Type-text, e.g. 'bool', 'list<string>'." },
        "default": {}
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "payloadType"],
      "properties": {
        "kind": { "const": "event" },
        "payloadType": { "type": "string" },
        "firesWhen": {
          "type": "object",
          "additionalProperties": false,
          "required": ["prop", "becomes"],
          "properties": {
            "prop": { "type": "string" },
            "becomes": {}
          },
          "description": "Auto-fires this event whenever the named prop's value changes to equal `becomes` (never on initial mount)."
        },
        "trigger": {
          "$ref": "#/$defs/trigger",
          "description": "Fires this event directly off a DOM trigger on this component's own root element — payloadType must be record{} (checked by checkComposition)."
        }
      }
    },
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": { "kind": { "const": "slot" } }
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "returnType"],
      "properties": {
        "kind": { "const": "method" },
        "params": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "type"],
            "properties": { "name": { "type": "string" }, "type": { "type": "string" } }
          }
        },
        "returnType": { "type": "string" }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "const": "field" },
        "secret": { "type": "boolean", "description": "Renders as a native password input (type=\"password\") instead of text." },
        "initialValue": { "type": "string", "description": "Defaults to \"\" if omitted." },
        "validate": { "type": "string", "description": "Expression-language text (§6.4), evaluated against `{ [name]: currentValue }`. Omitted means always valid." },
        "invalidMessage": { "type": "string", "description": "Shown once the field has been touched and validate() is currently false." }
      }
    },
    "derived": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "type", "expr"],
      "properties": {
        "kind": { "const": "derived" },
        "type": { "type": "string", "description": "Type-text, e.g. 'bool'." },
        "expr": { "type": "string", "description": "Expression-language text (§6.4), evaluated against this component's own props/fields." }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "const": "state" },
        "flags": { "type": "object", "additionalProperties": { "type": "boolean" } }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "from", "to", "trigger"],
      "properties": {
        "kind": { "const": "transition" },
        "from": { "type": "string" },
        "to": { "type": "string" },
        "trigger": { "$ref": "#/$defs/trigger" },
        "guard": { "type": "string", "description": "Expression-language text (§6.4)." }
      }
    },
    "guard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "predicate"],
      "properties": {
        "kind": { "const": "guard" },
        "predicate": { "type": "string" }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "condition", "outcome"],
      "properties": {
        "kind": { "const": "rule" },
        "condition": { "type": "string" },
        "outcome": { "type": "string" }
      }
    },
    "invariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "predicate"],
      "properties": {
        "kind": { "const": "invariant" },
        "predicate": { "type": "string" },
        "verify": { "type": "string", "enum": ["unit", "interaction", "a11y", "visual"] }
      }
    },
    "property": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ident", "domain", "predicate"],
      "properties": {
        "kind": { "const": "property" },
        "ident": { "type": "string" },
        "domain": { "type": "string", "description": "Domain-language text (§6.5)." },
        "predicate": { "type": "string" },
        "verify": { "type": "string", "enum": ["unit", "interaction", "a11y", "visual"] }
      }
    },
    "path": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "from", "events", "to"],
      "properties": {
        "kind": { "const": "path" },
        "from": { "type": "string" },
        "events": { "type": "array", "items": { "$ref": "#/$defs/trigger" } },
        "to": { "type": "string" },
        "verify": { "type": "string", "enum": ["unit", "interaction", "a11y", "visual"] }
      }
    },
    "unexpressible": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": { "kind": { "const": "unexpressible" } }
    },
    "patternConformance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "pattern"],
      "properties": {
        "kind": { "const": "pattern-conformance" },
        "pattern": { "type": "string", "description": "APG pattern name, e.g. 'checkbox'." },
        "verify": { "type": "string", "enum": ["unit", "interaction", "a11y", "visual"] }
      }
    },
    "delta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": { "kind": { "const": "delta" } }
    },
    "ariaRelation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "relation"],
      "properties": {
        "kind": { "const": "aria-relation" },
        "relation": { "type": "string" }
      }
    },
    "tokenRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "part", "property", "token"],
      "properties": {
        "kind": { "const": "token-ref" },
        "part": { "type": "string", "description": "\"root\" or an existing slot name." },
        "property": { "type": "string", "description": "CSS property name, e.g. 'background-color'." },
        "token": { "type": "string", "description": "Design token path, e.g. 'color.surface.default' — never a raw value." }
      }
    },
    "layoutIntent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "part", "display"],
      "properties": {
        "kind": { "const": "layout-intent" },
        "part": { "type": "string" },
        "display": { "type": "string", "enum": ["flex", "grid"] },
        "direction": { "type": "string", "enum": ["row", "column"] },
        "gapToken": { "type": "string" },
        "align": { "type": "string" },
        "justify": { "type": "string" }
      }
    },
    "visualConformance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reference"],
      "properties": {
        "kind": { "const": "visual-conformance" },
        "reference": { "type": "string", "description": "Path/URL to a reference frame or visual-regression baseline id." },
        "verify": { "type": "string", "enum": ["unit", "interaction", "a11y", "visual"] }
      }
    },
    "uses": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "component"],
      "properties": {
        "kind": { "const": "uses" },
        "component": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
          "description": "Sibling spec slug to instantiate — resolved the same way `extends` refs are."
        },
        "root": {
          "type": "boolean",
          "description": "Exactly one `uses` node per component must set this true — the outermost embedded instance."
        },
        "props": {
          "type": "object",
          "additionalProperties": true,
          "description": "Literal prop values, or `{ expr: <expression text> }` for a value live-computed at render time from this component's own fields/props. Checked against the referenced component's declared props at parse time, not by this schema."
        },
        "slotContent": { "$ref": "#/$defs/usesSlotContent" },
        "on": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              { "type": "string", "description": "Sugar for { event: <string> } — fires the named own-event with an empty payload." },
              { "$ref": "#/$defs/onWireTarget" },
              { "type": "array", "items": { "oneOf": [{ "type": "string" }, { "$ref": "#/$defs/onWireTarget" }] }, "minItems": 1 }
            ]
          },
          "description": "Maps this embedded child instance's declared event name to one or more of this component's own declared events to fire."
        },
        "visibleWhen": {
          "type": "string",
          "description": "Root node only: name of a bool prop on this component gating whether the composed subtree renders at all."
        }
      }
    },
    "usesSlotContent": {
      "type": "object",
      "description": "Keyed by slot name on the *referenced* component. Values are checked against that component's declared slots at parse time.",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["text"],
            "properties": { "text": { "type": "string" } }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["uses"],
            "properties": {
              "uses": {
                "type": "array",
                "items": { "type": "string" },
                "minItems": 1,
                "description": "Ordered list of other `uses` node names (siblings in this same component's Composition section) to nest into this slot."
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["fields"],
            "properties": {
              "fields": {
                "type": "array",
                "items": { "type": "string" },
                "minItems": 1,
                "description": "Ordered list of this component's own declared FieldNode names, rendered inline as native <input> elements in this slot position."
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["each"],
            "properties": {
              "each": {
                "type": "object",
                "additionalProperties": false,
                "required": ["over", "as", "use"],
                "properties": {
                  "over": { "type": "string", "description": "Name of a declared prop on this component, of type list<T> — the collection to iterate." },
                  "as": { "type": "string", "description": "Bound name for each item, in scope inside `use`'s own props/slotContent { expr } values." },
                  "use": { "type": "string", "description": "Name of a sibling `uses` node in this component's Composition section, instantiated once per item." },
                  "key": { "type": "string", "description": "Name of a field of T (T must be a record) — used as React's key / Angular's trackBy." }
                }
              }
            }
          }
        ]
      }
    },
    "onWireTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event"],
      "properties": {
        "event": { "type": "string" },
        "payload": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "description": "Maps a field of the fired event's declared payloadType record to a source name — a sibling FieldNode name or a declared prop name, both on this component."
        }
      }
    }
  }
}
